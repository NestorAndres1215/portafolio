---
---
<script src="../i18n/translations.ts"></script>

<nav class="navbar">
  <div class="container">
    <a href="#inicio" class="logo">
      <div class="logo-icon"><i class="fa-solid fa-code"></i></div>
      <span>Nestor<strong>Dev</strong></span>
    </a>

    <div class="menu">
      <a href="#inicio"    data-i18n="nav.inicio">Inicio</a>
      <a href="#sobre"     data-i18n="nav.sobre">Sobre mí</a>
      <a href="#skills"    data-i18n="nav.skills">Tecnologías</a>
      <a href="#proyectos" data-i18n="nav.proyectos">Proyectos</a>
      <a href="#contacto"  data-i18n="nav.contacto">Contacto</a>

      <button id="lang-toggle" class="lang-toggle">
        <i class="fa-solid fa-globe"></i>
        <span id="lang-label">ES</span>
      </button>
    </div>

    <button class="burger" id="burger" aria-label="Menú">
      <i class="fa-solid fa-bars"></i>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <a href="#inicio"    data-i18n="nav.inicio"    onclick="closeMobile()"><i class="fa-solid fa-house"></i> <span>Inicio</span></a>
    <a href="#sobre"     data-i18n="nav.sobre"     onclick="closeMobile()"><i class="fa-solid fa-user"></i> <span>Sobre mí</span></a>
    <a href="#skills"    data-i18n="nav.skills"    onclick="closeMobile()"><i class="fa-solid fa-layer-group"></i> <span>Tecnologías</span></a>
    <a href="#proyectos" data-i18n="nav.proyectos" onclick="closeMobile()"><i class="fa-solid fa-folder-open"></i> <span>Proyectos</span></a>
    <a href="#contacto"  data-i18n="nav.contacto"  onclick="closeMobile()"><i class="fa-solid fa-envelope"></i> <span>Contacto</span></a>
  </div>
</nav>

<script>
  import { translations, type Lang } from '../i18n/translations';

  // Burger
  const burger     = document.getElementById('burger')!;
  const mobileMenu = document.getElementById('mobileMenu')!;
  burger.addEventListener('click', () => {
    mobileMenu.classList.toggle('open');
    burger.querySelector('i')!.classList.toggle('fa-bars');
    burger.querySelector('i')!.classList.toggle('fa-xmark');
  });
  function closeMobile() {
    mobileMenu.classList.remove('open');
    burger.querySelector('i')!.classList.add('fa-bars');
    burger.querySelector('i')!.classList.remove('fa-xmark');
  }
  (window as any).closeMobile = closeMobile;

  // Lang toggle
  const btn   = document.getElementById('lang-toggle')!;
  const label = document.getElementById('lang-label')!;
  let lang: Lang = (localStorage.getItem('lang') as Lang) || 'es';
  label.textContent = lang.toUpperCase();

  function applyLang(l: Lang) {
    const t = translations[l];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = (el as HTMLElement).dataset.i18n!;
      const keys = key.split('.');
      let val: any = t;
      for (const k of keys) val = val?.[k];
      if (val) {
        const span = el.querySelector('span');
        if (span) span.textContent = val;
        else el.textContent = val;
      }
    });
  }

  btn.addEventListener('click', () => {
    lang = lang === 'es' ? 'en' : 'es';
    localStorage.setItem('lang', lang);
    label.textContent = lang.toUpperCase();
    applyLang(lang);
    window.dispatchEvent(new CustomEvent('lang-change', { detail: lang }));
  });
  applyLang(lang);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; }

  .navbar {
    position: fixed;
    top: 0; width: 100%; z-index: 50;
    background: rgba(11,15,26,0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-family: 'DM Sans', sans-serif;
  }
  .container {
    max-width: 1100px; margin: 0 auto;
    padding: 0 24px; height: 64px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .logo {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; color: #f1f5f9;
  }
  .logo-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: rgba(99,102,241,0.15); color: #818cf8;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; box-shadow: 0 0 16px rgba(99,102,241,0.2);
  }
  .logo span { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; color: #cbd5e1; }
  .logo strong { color: #818cf8; font-weight: 800; }

  .menu { display: flex; align-items: center; gap: 4px; }
  .menu a {
    display: flex; align-items: center; gap: 6px;
    padding: 7px 14px; border-radius: 8px;
    text-decoration: none; color: #475569;
    font-size: 13px; font-weight: 500;
    transition: color 0.2s, background 0.2s;
  }
  .menu a:hover { color: #e2e8f0; background: rgba(255,255,255,0.05); }

  .lang-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 14px; border-radius: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: #64748b; font-size: 13px; font-weight: 600;
    font-family: 'Syne', sans-serif; cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    margin-left: 8px;
  }
  .lang-toggle:hover { background: rgba(99,102,241,0.08); border-color: rgba(129,140,248,0.2); color: #818cf8; }
  .lang-toggle i { font-size: 12px; }

  .burger {
    display: none; background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08); color: #94a3b8;
    width: 36px; height: 36px; border-radius: 8px;
    cursor: pointer; align-items: center; justify-content: center;
    font-size: 14px; transition: background 0.2s, color 0.2s;
  }
  .burger:hover { background: rgba(255,255,255,0.09); color: #e2e8f0; }

  .mobile-menu { display: none; flex-direction: column; padding: 12px 16px 16px; border-top: 1px solid rgba(255,255,255,0.05); gap: 4px; }
  .mobile-menu.open { display: flex; }
  .mobile-menu a { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 10px; text-decoration: none; color: #475569; font-size: 14px; font-weight: 500; transition: color 0.2s, background 0.2s; }
  .mobile-menu a i { font-size: 12px; color: #818cf8; }
  .mobile-menu a:hover { color: #e2e8f0; background: rgba(255,255,255,0.05); }

  @media (max-width: 768px) { .menu { display: none; } .burger { display: flex; } }
</style>