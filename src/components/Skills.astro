---

<section id="skills" class="skills">
    <div class="bg-grid"></div>
    <div class="bg-glow"></div>

    <div class="skills-container">
        <div class="section-label">
            <i class="fa-solid fa-layer-group"></i>
            <span id="skills-label">Stack tecnológico</span>
        </div>

        <h2 class="skills-title">
            <span id="skills-titulo">Tecnologías</span><span class="dot">.</span
            >
        </h2>
        <p class="skills-sub" id="skills-sub">
            Herramientas y lenguajes con los que construyo soluciones
        </p>

        <div class="categories">
            <div class="category">
                <div class="category-label">
                    <i class="fa-solid fa-server"></i>
                    <span id="cat-backend">Backend</span>
                </div>
                <div class="skills-grid">
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--orange">
                            <i class="fa-brands fa-java"></i>
                        </div><span>Java</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--green">
                            <i class="fa-solid fa-leaf"></i>
                        </div><span>Spring Boot</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--blue">
                            <i class="fa-brands fa-node-js"></i>
                        </div><span>Node.js</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--gray">
                            <i class="fa-solid fa-bolt"></i>
                        </div><span>Express</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--red">
                            <i class="fa-solid fa-fire"></i>
                        </div><span>NestJS</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--yellow">
                            <i class="fa-solid fa-key"></i>
                        </div><span>JWT</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--blue">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div><span>OAuth</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--black">
                            <i class="fa-solid fa-arrows-spin"></i>
                        </div><span>Apache Kafka</span>
                    </div>
                </div>
            </div>

            <div class="category">
                <div class="category-label">
                    <i class="fa-solid fa-display"></i>
                    <span id="cat-frontend">Frontend</span>
                </div>
                <div class="skills-grid">
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--yellow">
                            <i class="fa-brands fa-js"></i>
                        </div><span>JavaScript</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--cyan">
                            <i class="fa-brands fa-react"></i>
                        </div><span>React</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--green">
                            <i class="fa-brands fa-vuejs"></i>
                        </div><span>Vue</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--red">
                            <i class="fa-brands fa-angular"></i>
                        </div><span>Angular</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--purple">
                            <i class="fa-solid fa-rocket"></i>
                        </div><span>Astro</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--purple">
                            <i class="fa-solid fa-bolt"></i>
                        </div><span>Vite</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--blue">
                            <i class="fa-brands fa-css3-alt"></i>
                        </div><span>CSS</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--purple">
                            <i class="fa-brands fa-bootstrap"></i>
                        </div><span>Bootstrap</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--green">
                            <i class="fa-solid fa-leaf"></i>
                        </div><span>Thymeleaf</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--gray">
                            <i class="fa-solid fa-file-code"></i>
                        </div><span>EJS</span>
                    </div>
                </div>
            </div>
            <div class="category">
                <div class="category-label">
                    <i class="fa-solid fa-database"></i>
                    <span id="cat-db">Base de datos</span>
                </div>
                <div class="skills-grid">
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--blue">
                            <i class="fa-solid fa-database"></i>
                        </div><span>MySQL</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--indigo">
                            <i class="fa-solid fa-database"></i>
                        </div><span>PostgreSQL</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--green">
                            <i class="fa-solid fa-leaf"></i>
                        </div><span>MongoDB</span>
                    </div>
                </div>
            </div>
            <div class="category">
                <div class="category-label">
                    <i class="fa-solid fa-wrench"></i>
                    <span id="cat-tools">Herramientas</span>
                </div>
                <div class="skills-grid">
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--cyan">
                            <i class="fa-brands fa-docker"></i>
                        </div><span>Docker</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--orange">
                            <i class="fa-brands fa-git-alt"></i>
                        </div><span>Git</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--gray">
                            <i class="fa-brands fa-github"></i>
                        </div><span>GitHub</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--red">
                            <i class="fa-solid fa-paper-plane"></i>
                        </div><span>Postman</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--green">
                            <i class="fa-solid fa-book-open"></i>
                        </div><span>Swagger</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--red">
                            <i class="fa-solid fa-gears"></i>
                        </div><span>Jenkins</span>
                    </div>
                </div>
            </div>
            <div class="category">
                <div class="category-label">
                    <i class="fa-solid fa-laptop-code"></i>
                    <span id="cat-ides">IDEs & Editores</span>
                </div>
                <div class="skills-grid">
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--blue">
                            <i class="fa-solid fa-code"></i>
                        </div><span>Visual Studio Code</span>
                    </div>
                    <div class="skill-card">
                        <div class="skill-icon skill-icon--orange">
                            <i class="fa-solid fa-brain"></i>
                        </div><span>IntelliJ IDEA</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { translations, type Lang } from "../i18n/translations";

    let lang: Lang = (localStorage.getItem("lang") as Lang) || "es";

    function applyLang(l: Lang) {
        const t = translations[l].skills;
        document.getElementById("skills-label")!.textContent = t.label;
        document.getElementById("skills-titulo")!.textContent = t.titulo;
        document.getElementById("skills-sub")!.textContent = t.sub;
        document.getElementById("cat-backend")!.textContent =
            t.categorias.backend;
        document.getElementById("cat-frontend")!.textContent =
            t.categorias.frontend;
        document.getElementById("cat-db")!.textContent = t.categorias.db;
        document.getElementById("cat-tools")!.textContent = t.categorias.tools;
        document.getElementById("cat-ides")!.textContent = t.categorias.ides;
    }

    applyLang(lang);
    window.addEventListener("lang-change", (e: any) => {
        lang = e.detail;
        applyLang(lang);
    });
</script>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap");

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .skills {
        position: relative;
        background: #0b0f1a;
        padding: 100px 24px 80px;
        font-family: "DM Sans", sans-serif;
        overflow: hidden;
    }

    .bg-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.03) 1px,
                transparent 1px
            );
        background-size: 40px 40px;
        pointer-events: none;
    }

    .bg-glow {
        position: absolute;
        bottom: -150px;
        left: -100px;
        width: 600px;
        height: 500px;
        background: radial-gradient(
            ellipse,
            rgba(99, 102, 241, 0.07) 0%,
            transparent 70%
        );
        pointer-events: none;
    }

    .skills-container {
        position: relative;
        z-index: 1;
        max-width: 1000px;
        margin: 0 auto;
    }

    /* Label */
    .section-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.08);
        border: 1px solid rgba(99, 102, 241, 0.2);
        color: #818cf8;
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 20px;
    }
    .section-label i {
        font-size: 11px;
    }

    .skills-title {
        font-family: "Syne", sans-serif;
        font-size: clamp(32px, 5vw, 48px);
        font-weight: 800;
        color: #f1f5f9;
        letter-spacing: -1.5px;
        margin-bottom: 10px;
    }
    .dot {
        color: #818cf8;
    }

    .skills-sub {
        color: #475569;
        font-size: 14px;
        font-weight: 300;
        margin-bottom: 56px;
    }

    /* Categorías */
    .categories {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .category-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #334155;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 16px;
    }
    .category-label i {
        color: #818cf8;
        font-size: 11px;
    }

    /* Grid de skills */
    .skills-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .skill-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px 10px 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 12px;
        cursor: default;
        transition:
            background 0.2s,
            border-color 0.2s,
            transform 0.2s;
    }
    .skill-card:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(129, 140, 248, 0.25);
        transform: translateY(-2px);
    }

    .skill-card span {
        font-size: 13px;
        font-weight: 500;
        color: #94a3b8;
        white-space: nowrap;
    }

    /* Íconos */
    .skill-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .skill-icon--orange {
        background: rgba(251, 146, 60, 0.12);
        color: #fb923c;
    }
    .skill-icon--green {
        background: rgba(34, 197, 94, 0.12);
        color: #4ade80;
    }
    .skill-icon--blue {
        background: rgba(59, 130, 246, 0.12);
        color: #60a5fa;
    }
    .skill-icon--gray {
        background: rgba(148, 163, 184, 0.1);
        color: #94a3b8;
    }
    .skill-icon--red {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
    }
    .skill-icon--yellow {
        background: rgba(250, 204, 21, 0.12);
        color: #facc15;
    }
    .skill-icon--cyan {
        background: rgba(34, 211, 238, 0.12);
        color: #22d3ee;
    }
    .skill-icon--purple {
        background: rgba(168, 85, 247, 0.12);
        color: #c084fc;
    }
    .skill-icon--indigo {
        background: rgba(99, 102, 241, 0.12);
        color: #818cf8;
    }

    @media (max-width: 600px) {
        .skill-card {
            padding: 8px 14px 8px 10px;
        }
        .skill-icon {
            width: 28px;
            height: 28px;
            font-size: 13px;
        }
        .skill-card span {
            font-size: 12px;
        }
    }
</style>
