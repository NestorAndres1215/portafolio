---

<footer class="footer">
  <div class="bg-grid"></div>
  <div class="footer-line"></div>

  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo-icon">
          <i class="fa-solid fa-code"></i>
        </div>
        <div>
          <h3 class="footer-title">Nestor<span>Dev</span></h3>
          <p class="footer-text" id="footer-subtitulo">
            Desarrollador Java y Web
          </p>
        </div>
      </div>
      <div class="footer-socials">
        <a
          href="https://github.com/NestorAndres1215"
          target="_blank"
          rel="noopener"
          class="social-btn"
        >
          <i class="fa-brands fa-github"></i>
        </a>
        <a
          href="https://www.linkedin.com/in/nestorat/"
          target="_blank"
          rel="noopener"
          class="social-btn social-btn--linkedin"
        >
          <i class="fa-brands fa-linkedin-in"></i>
        </a>
        <a
          href="mailto:atiroandres@gmail.com"
          class="social-btn social-btn--email"
        >
          <i class="fa-solid fa-envelope"></i>
        </a>
      </div>
    </div>

    <div class="footer-nav">
      <a href="#inicio" id="fnav-inicio">Inicio</a>
      <a href="#sobre" id="fnav-sobre">Sobre mí</a>
      <a href="#skills" id="fnav-skills">Tecnologías</a>
      <a href="#proyectos" id="fnav-proyectos">Proyectos</a>
      <a href="#contacto" id="fnav-contacto">Contacto</a>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p class="footer-copy" id="footer-derechos">
        © 2026 Nestor. Todos los derechos reservados.
      </p>
      <p class="footer-made">
        <span id="footer-hecho">Hecho con</span>
        <i class="fa-solid fa-heart"></i>
        <span id="footer-cafe">y mucho café</span>
        <i class="fa-solid fa-mug-hot"></i>
      </p>
    </div>
  </div>
</footer>

<script>
  import { translations, type Lang } from "../i18n/translations";

  let lang: Lang = (localStorage.getItem("lang") as Lang) || "es";

  function applyLang(l: Lang) {
    const t = translations[l];
    const tf = t.footer;
    const tn = t.nav;

    document.getElementById("footer-subtitulo")!.textContent = tf.subtitulo;
    document.getElementById("footer-derechos")!.textContent = tf.derechos;

    if (l === "es") {
      document.getElementById("footer-hecho")!.textContent = "Hecho con";
      document.getElementById("footer-cafe")!.textContent = "y mucho café";
    } else {
      document.getElementById("footer-hecho")!.textContent = "Made with";
      document.getElementById("footer-cafe")!.textContent =
        "and lots of coffee";
    }

    document.getElementById("fnav-inicio")!.textContent = tn.inicio;
    document.getElementById("fnav-sobre")!.textContent = tn.sobre;
    document.getElementById("fnav-skills")!.textContent = tn.skills;
    document.getElementById("fnav-proyectos")!.textContent = tn.proyectos;
    document.getElementById("fnav-contacto")!.textContent = tn.contacto;
  }

  applyLang(lang);
  window.addEventListener("lang-change", (e: any) => {
    lang = e.detail;
    applyLang(lang);
  });
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap");

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .footer {
    position: relative;
    background: #0b0f1a;
    padding: 60px 24px 32px;
    font-family: "DM Sans", sans-serif;
    overflow: hidden;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .footer-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(129, 140, 248, 0.3) 30%,
      rgba(129, 140, 248, 0.3) 70%,
      transparent
    );
  }

  .footer-container {
    position: relative;
    z-index: 1;
    max-width: 1000px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(99, 102, 241, 0.12);
    color: #818cf8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    box-shadow: 0 0 20px rgba(99, 102, 241, 0.15);
    flex-shrink: 0;
  }

  .footer-title {
    font-family: "Syne", sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #cbd5e1;
    letter-spacing: -0.5px;
  }
  .footer-title span {
    color: #818cf8;
  }

  .footer-text {
    font-size: 12px;
    color: #334155;
    font-weight: 300;
    margin-top: 2px;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }

  .social-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .social-btn:hover {
    background: rgba(148, 163, 184, 0.08);
    border-color: rgba(148, 163, 184, 0.2);
    color: #94a3b8;
    transform: translateY(-2px);
  }
  .social-btn--linkedin:hover {
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
  }
  .social-btn--email:hover {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(129, 140, 248, 0.2);
    color: #818cf8;
  }

  .footer-nav {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .footer-nav a {
    padding: 6px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: #334155;
    font-size: 13px;
    font-weight: 500;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .footer-nav a:hover {
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
  }

  .footer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.05);
    margin-bottom: 24px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .footer-copy {
    font-size: 12px;
    color: #1e293b;
    font-weight: 400;
  }

  .footer-made {
    font-size: 12px;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .footer-made .fa-heart {
    color: #f87171;
    font-size: 11px;
  }
  .footer-made .fa-mug-hot {
    color: #fbbf24;
    font-size: 11px;
  }

  @media (max-width: 560px) {
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer-nav {
      justify-content: center;
    }
  }
</style>
