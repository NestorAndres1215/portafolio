---
const { project } = Astro.props;
const slug = project.github.split('/').pop();
---

<div class="project-card">
  <div class="card-header">
    <div class="card-icon">
      <i class="fa-solid fa-folder-open"></i>
    </div>
    <div class="card-links">
      <a href={project.github} target="_blank" rel="noopener" class="icon-link" title="GitHub">
        <i class="fa-brands fa-github"></i>
      </a>
      {project.demo && (
        <a href={project.demo} target="_blank" rel="noopener" class="icon-link" title="Ver demo">
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </a>
      )}
    </div>
  </div>

  <h3 class="project-title card-title"
    data-es={project.title.es}
    data-en={project.title.en}>
    {project.title.es}
  </h3>

  <p class="project-description card-desc"
    data-es={project.description.es}
    data-en={project.description.en}>
    {project.description.es}
  </p>

  <div class="project-techs">
    {project.tech.split(',').map((t: string) => (
      <span class="tech-chip">{t.trim()}</span>
    ))}
  </div>

  <div class="card-footer">
    <a href={project.github} target="_blank" rel="noopener" class="btn-code">
      <i class="fa-brands fa-github"></i>
      <span class="btn-code-text">Ver código</span>
    </a>
  </div>
</div>

<script>
  import { translations, type Lang } from '../i18n/translations';

  function applyLang(lang: Lang) {
    // Botones "Ver código"
    document.querySelectorAll<HTMLElement>('.btn-code-text').forEach(el => {
      el.textContent = translations[lang].proyectos.verCodigo;
    });

    // Títulos de cards
    document.querySelectorAll<HTMLElement>('.card-title').forEach(el => {
      el.textContent = el.dataset[lang] ?? el.textContent;
    });

    // Descripciones de cards
    document.querySelectorAll<HTMLElement>('.card-desc').forEach(el => {
      el.textContent = el.dataset[lang] ?? el.textContent;
    });
  }

  const savedLang = (localStorage.getItem('lang') as Lang) || 'es';
  applyLang(savedLang);

  window.addEventListener('lang-change', (e: any) => applyLang(e.detail));
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap");

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    font-family: "DM Sans", sans-serif;
    transition:
      border-color 0.2s,
      background 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
    height: 100%;
  }
  .project-card:hover {
    border-color: rgba(129, 140, 248, 0.3);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(99, 102, 241, 0.1);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(99, 102, 241, 0.1);
    color: #818cf8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }

  .card-links {
    display: flex;
    gap: 8px;
  }

  .icon-link {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .icon-link:hover {
    background: rgba(129, 140, 248, 0.1);
    border-color: rgba(129, 140, 248, 0.3);
    color: #818cf8;
  }

  .project-title {
    font-family: "Syne", sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #f1f5f9;
    letter-spacing: -0.5px;
    line-height: 1.3;
  }

  .project-description {
    color: #475569;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    flex: 1;
  }

  .project-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .tech-chip {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.15);
    color: #818cf8;
    font-size: 11px;
    font-weight: 500;
  }

  .card-footer {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .btn-code {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    font-family: "Syne", sans-serif;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .btn-code:hover {
    background: rgba(129, 140, 248, 0.1);
    border-color: rgba(129, 140, 248, 0.3);
    color: #818cf8;
  }
  .btn-code i {
    font-size: 14px;
  }
</style>
